#!/usr/bin/env bash
# ============================================================================
# aether — Lanzador global del agente Aether (LangGraph + Ollama).
#
# Permite ejecutar Aether desde CUALQUIER directorio, sin necesidad de
# `cd` al proyecto ni activar el venv a mano:
#
#   aether                → TUI moderna  (equivale a: cd <proyecto> && python run.py)
#   aether tui            → idem, explícito
#   aether task "ORDEN"   → one-shot: ejecuta UNA orden y devuelve la respuesta
#   aether --workdir RUTA  → trabaja sobre RUTA (default: dir. actual $PWD)
#   aether doctor         → diagnóstico del entorno (python, venv, ollama, db)
#   aether web            → levanta la Web UI (backend API + navegador)
#                           aliases: aether server / aether gateway
#   aether -V | --version → versión del runtime
#   aether -h | --help    → esta ayuda
#
# Se auto-localiza: funciona copiado Y como symlink (p.ej. en ~/.local/bin).
# Se puede forzar intérprete con la env var AETHER_PYTHON.
# ============================================================================
set -euo pipefail

# ── 1) Localizar el directorio real del proyecto (soporta symlinks) ────────
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
AETHER_HOME="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

# ── 1b) Capturar el directorio de invocación ANTES del cd ─────────────────
# RUTA_TRABAJO (settings.py) lee $AETHER_CWD: así el agente trabaja en
# ~/Documents, ~/Proyecto, etc. según desde dónde lo llames.
AETHER_CWD="$PWD"
EXTRA_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --workdir)
      AETHER_CWD="$2" || true; EXTRA_ARGS+=("$1" "$2"); shift 2 ;;
    --workdir=*)
      AETHER_CWD="${1#--workdir=}"; EXTRA_ARGS+=("$1"); shift ;;
    tui|task|doctor|version|--doctor)
      EXTRA_ARGS+=("$1"); shift ;;
    -t|--task)
      EXTRA_ARGS+=("task"); shift ;;
    -V|--version)
      EXTRA_ARGS+=("version"); shift ;;
    *) EXTRA_ARGS+=("$1"); shift ;;
  esac
done
if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
  set -- "${EXTRA_ARGS[@]}"
else
  set --
fi
export AETHER_CWD
[[ -n "${AETHER_WORKDIR_SHOW:-}" ]] && echo "Dir. trabajo: $AETHER_CWD"

# ── 2) Elegir el intérprete (venvs probados en orden de prioridad) ────────
PY=""
if [[ -n "${AETHER_PYTHON:-}" && -x "$AETHER_PYTHON" ]]; then
  PY="$AETHER_PYTHON"
fi
for cand in \
    "$AETHER_HOME/env/bin/python" \
    "$AETHER_HOME/crewai-env/bin/python" \
    "$AETHER_HOME/.venv/bin/python"; do
  if [[ -z "$PY" && -x "$cand" ]]; then
    PY="$cand"
    break
  fi
done
if [[ -z "$PY" ]]; then
  PY="$(command -v python3 || true)"
fi
if [[ -z "$PY" ]]; then
  echo "❌ No se encontró Python. Configurá AETHER_PYTHON apuntando a un venv con textual instalado." >&2
  exit 1
fi

# ── 3) Ejecutar (el cwd pasa a ser el proyecto: misma base que antes) ─────
# NOTA workdir: el `cd` es intencional (imports/venv estables). El dir. de
# invocación viaja en $AETHER_CWD → settings.RUTA_TRABAJO; shell y file
# tools ya operan ahí. `aether --workdir R` lo pisa (ver 1b arriba).
cd "$AETHER_HOME"
# --workdir puede venir en cualquier posición (argparse de Python lo maneja);
# como bin/aether YA fijó AETHER_CWD arriba, solo hay que sacarlo de $@ si
# quedó pegado al subcomando task, y pasarlo como flag de aether_run.py.
# Casos: `aether --workdir R task "..."` / `aether task --workdir R "..."`.
WORKDIR_FLAG=()
ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --workdir) WORKDIR_FLAG=(--workdir "$2"); shift 2 ;;
    --workdir=*) WORKDIR_FLAG=("$1"); shift ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
if [[ ${#ARGS[@]} -gt 0 ]]; then
  set -- "${ARGS[@]}"
else
  set --
fi
case "${1:-}" in
  -h|--help)
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  version|-V|--version)
    exec "$PY" bin/aether_run.py version
    ;;
  -t|--task|task)
    shift
    exec "$PY" bin/aether_run.py task "${WORKDIR_FLAG[@]}" "$@"
    ;;
  doctor|--doctor)
    exec "$PY" bin/aether_run.py doctor
    ;;
  web|server|gateway)
    shift || true
    # ── Web UI: backend API (FastAPI, sirve también los estáticos) ──
    PORT="${AETHER_WEB_PORT:-8000}"
    URL="http://127.0.0.1:$PORT"
    WEB_UI_ROOT="${WEB_UI_DIR:-$HOME/aether_web_ui}"
    STATEDIR="${XDG_STATE_HOME:-$HOME/.local/state}/aether"
    mkdir -p "$STATEDIR"
    LOG="$STATEDIR/web.log"

    NO_BROWSER=0
    for a in "$@"; do [ "$a" = "--no-browser" ] && NO_BROWSER=1; done

    # La Web UI vive en su propio repo (instalable desde el instalador):
    if [ ! -d "$WEB_UI_ROOT/web" ]; then
      echo "⚠️  Web UI no encontrada en $WEB_UI_ROOT/web"
      echo "   Instalala con:  git clone https://github.com/Thomi33/aether_web_ui.git ~/aether_web_ui"
      exit 1
    fi

    if curl -sf --max-time 2 "$URL/health" >/dev/null 2>&1; then
      echo "✅ Backend ya activo en $URL"
    else
      echo "🚀 Levantando backend Aether (log: $LOG)…"
      cd "$AETHER_HOME"
      # El backend usa .venv (igual que backend/run.sh): la prioridad de
      # venvs de $PY apunta a env/ (TUI), que no tiene fastapi/uvicorn.
      PY_WEB="$PY"
      [ -x "$AETHER_HOME/.venv/bin/python" ] && PY_WEB="$AETHER_HOME/.venv/bin/python"
      setsid nohup "$PY_WEB" -m uvicorn backend.api.main:app \
        --host 127.0.0.1 --port "$PORT" >"$LOG" 2>&1 </dev/null &
      # Esperar a que responda (la primera inicialización tarda unos segundos)
      listo=0
      for _ in $(seq 1 60); do
        curl -sf --max-time 2 "$URL/health" >/dev/null 2>&1 && { listo=1; break; }
        sleep 1
      done
      if [ "$listo" != "1" ]; then
        echo "❌ El backend no levantó en 60 s. Revisá el log: $LOG" >&2
        exit 1
      fi
      echo "✅ Backend listo en $URL"
    fi

    if [ "$NO_BROWSER" = "0" ]; then
      echo "🌐 Abriendo $URL en tu navegador…"
      if command -v xdg-open >/dev/null 2>&1; then
        (xdg-open "$URL" >/dev/null 2>&1 &)
      elif command -v open >/dev/null 2>&1; then
        open "$URL" >/dev/null 2>&1 || true
      elif command -v wslview >/dev/null 2>&1; then
        (wslview "$URL" >/dev/null 2>&1 &)
      else
        echo "   Abrí manualmente: $URL"
      fi
    else
      echo "   → $URL"
    fi
    exit 0
    ;;
  *)
    exec "$PY" run.py "${WORKDIR_FLAG[@]}" "$@"
    ;;
esac