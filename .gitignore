# MCP servers — dos capas (mismo patrón que config.json/config.local.json):
#   mcp_servers.json        = plantilla VERSIONADA con placeholders "{token}".
#   mcp_servers.local.json  = tokens REALES + servers custom: JAMÁS se commitea.
core/config/mcp_servers.local.json
core/config/mcp_servers.local.json.tmp
core/config/mcp_servers.local.json.bak

